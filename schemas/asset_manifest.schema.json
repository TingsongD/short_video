{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_manifest.schema.json",
  "title": "AssetManifest",
  "description": "M6 -> M8 contract. Local media for one video. Frozen in Wave 0.",
  "type": "object",
  "required": ["video_id", "assets"],
  "properties": {
    "video_id": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_idx", "file", "kind", "source"],
        "properties": {
          "shot_idx": { "type": "integer", "minimum": 0 },
          "file": { "type": "string", "minLength": 1, "description": "path relative to the manifest's directory" },
          "kind": { "enum": ["video", "image"] },
          "source": { "enum": ["jimeng", "manual", "stock"] },
          "duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "width": { "type": "integer" },
          "height": { "type": "integer" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mpt_task.schema.json",
  "title": "MptTask",
  "description": "M8 internal contract. One MoneyPrinterTurbo CLI batch-manifest entry (VideoParams subset). Frozen in Wave 0.",
  "type": "object",
  "required": ["video_subject", "video_script", "video_source", "video_materials", "custom_audio_file", "video_aspect", "subtitle_enabled"],
  "properties": {
    "video_subject": { "type": "string", "minLength": 1 },
    "video_script": { "type": "string", "minLength": 1 },
    "video_language": { "type": "string", "default": "en" },
    "video_source": { "const": "local" },
    "video_materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "minLength": 1, "description": "local file path, resolved from the manifest directory" }
        }
      }
    },
    "custom_audio_file": { "type": "string", "minLength": 1 },
    "video_aspect": { "const": "9:16" },
    "video_count": { "type": "integer", "minimum": 1, "maximum": 5 },
    "subtitle_enabled": { "type": "boolean" },
    "subtitle_display_mode": { "enum": ["sentence", "word_by_word"] },
    "bgm_type": { "enum": ["none", "random", "custom"] },
    "bgm_volume": { "type": "number", "minimum": 0, "maximum": 1 },
    "voice_volume": { "type": "number", "minimum": 0, "maximum": 2 },
    "n_threads": { "type": "integer", "minimum": 1 }
  }
}
